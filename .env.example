# --- LLM (toute API compatible OpenAI) ---
# Ollama en local (gratuit) :  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  LLM_API_KEY=ollama
# Groq (gratuit, rapide)    :  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b
# Gemini                    :  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.0-flash
# OpenAI                    :  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.3

# --- RAG ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_DIR=data/chroma
COLLECTION=cours
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SEARCH_MODE=hybride


# --- Évaluation : juge RAGAS (Gemini, quota séparé de Groq) ---
EVAL_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EVAL_JUDGE_MODEL=gemini-2.5-flash
# Colle ta clé Gemini ici (aistudio.google.com > Get API key) :
EVAL_JUDGE_API_KEY=
