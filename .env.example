# mock = démonstration locale déterministe, sans appel réseau LLM
# real = client LLM compatible OpenAI configuré ci-dessous
ADAPTIVE_MODE=mock
ADAPTIVE_DB_PATH=data/adaptive_tutor.sqlite3
ADAPTIVE_POLICY_CHECKPOINT=models/linucb_demo_v1.json

# Exemples :
# Ollama : http://localhost:11434/v1 / qwen2.5:7b / ollama
# Groq   : https://api.groq.com/openai/v1 / modèle disponible / clé Groq
# OpenAI : https://api.openai.com/v1 / modèle disponible / clé OpenAI
# Gemini via endpoint compatible OpenAI : URL/modèle/clé fournis par Google
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=replace-with-provider-key-or-ollama
LLM_TEMPERATURE=0.3

EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_DIR=data/chroma
COLLECTION=cours
SEARCH_MODE=hybride
