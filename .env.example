# ============================================================
# Tuteur éducatif inclusif — environment variables
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# --- App identity ---
APP_NAME="Tuteur éducatif inclusif"
APP_ENV=development

# --- Agentic layer ---
# Backend mode: mock | tuteur (in-process) | http (remote services)
TUTOR_ENVIRONMENT=development
TUTOR_GENAI_BACKEND=mock
TUTOR_ALLOW_MOCKS=true

# When TUTOR_GENAI_BACKEND=http, set these:
TUTOR_RAG_SERVICE_URL=
TUTOR_GENAI_SERVICE_URL=
TUTOR_INCLUSION_SERVICE_URL=
TUTOR_LEARNING_RECORDS_SERVICE_URL=
# Shared bearer token for inter-service calls:
TUTOR_SERVICE_API_KEY=

# When TUTOR_GENAI_BACKEND=tuteur (in-process), set LLM below:

# --- Main LLM (any OpenAI-compatible endpoint) ---
# Examples:
#   Ollama local:    http://localhost:11434/v1  /  qwen2.5:7b    /  ollama
#   Groq (Qwen):     https://api.groq.com/openai/v1  /  qwen-qwen2.5-72b  /  gsk_...
#   Gemini:          https://generativelanguage.googleapis.com/v1beta/openai/  /  gemini-2.0-flash  /  AIza...
#   OpenAI:          https://api.openai.com/v1  /  gpt-4o  /  sk-...
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.3

# --- Embedding model (multilingual, handles AR/FR/EN) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Vision / VLM (for image description in RAG and accessibility) ---
# Leave empty to disable; set to any vision-capable OpenAI-compatible model
TUTOR_VISION_MODEL=
TUTOR_VISION_BASE_URL=
TUTOR_VISION_API_KEY=

# --- Security guard model (optional, fast model for input safety) ---
# Leave empty to disable the guard node
TUTOR_GUARD_MODEL=
TUTOR_GUARD_BASE_URL=
TUTOR_GUARD_API_KEY=

# --- RL service ---
# URL used by agentic layer to call the RL microservice
# In docker compose this is set automatically to http://rl:8001
TUTOR_RL_SERVICE_URL=http://localhost:8001
# Optional: path to a trained LinUCB checkpoint (.pkl)
RL_POLICY_CHECKPOINT=
# Optional: shared secret between api and rl services
RL_SERVICE_API_KEY=

# --- Development auth tokens (never use in production) ---
# Format: JSON object {"<token>": {"subject_ref": "...", "role": "student|teacher", "class_ids": []}}
# Leave empty to auto-generate tokens at startup (printed to stdout)
TUTOR_DEV_AUTH_TOKENS=

# --- RAG / Vector store ---
CHROMA_DIR=data/chroma
IMAGES_DIR=data/images
ADAPTED_IMAGES_DIR=data/images_adapted
RAG_SEARCH_MODE=hybride
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Student profiles DB (SQLite) ---
# Leave empty to use in-memory store (data lost on restart)
TUTOR_PROFILE_DB_PATH=data/profiles.db

# --- MLOps ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=tuteur-inclusif-dev

# --- Monitoring ---
OTEL_TRACES_ENABLED=true
OTEL_TRACES_EXPORTER=console
OTEL_SERVICE_NAME=tuteur-inclusif-api

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Ports (docker compose) ---
API_PORT=8000
RL_PORT=8001
MLFLOW_PORT=5000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
AIRFLOW_PORT=8080

# --- Airflow ---
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_JWT_SECRET=local-demo-jwt-secret-change-before-sharing
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_MLFLOW_EXPERIMENT_NAME=tuteur-inclusif-airflow-demo

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Quality thresholds ---
RAG_QUALITY_THRESHOLD=0.75
RL_POLICY_THRESHOLD=0.45
