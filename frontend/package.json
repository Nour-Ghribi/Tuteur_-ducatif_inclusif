{
  "name": "tutor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dynamic accessible interface of the Inclusive Educational Tutor (renders validated UI specs)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
