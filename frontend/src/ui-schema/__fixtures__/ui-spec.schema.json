        "back": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Back",
          "type": "string"
        }
      },
      "required": [
        "front",
        "back"
      ],
      "title": "FlashcardView",
      "type": "object"
    },
    "HeadingBlock": {
      "additionalProperties": false,
      "description": "Generated headings carry ``text``; system headings carry a localizable ``text_code``.",
      "properties": {
        "type": {
          "const": "heading",
          "default": "heading",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
