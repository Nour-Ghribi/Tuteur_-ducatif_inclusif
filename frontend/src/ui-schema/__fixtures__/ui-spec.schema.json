      "title": "FallbackBlock",
      "type": "object"
    },
    "FlashcardDeckBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "flashcard_deck",
          "default": "flashcard_deck",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "cards": {
          "items": {
            "$ref": "#/$defs/FlashcardView"
          },
          "maxItems": 30,
          "minItems": 1,
