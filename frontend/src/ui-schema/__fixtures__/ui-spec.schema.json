          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "concepts": {
          "items": {
            "$ref": "#/$defs/ConceptView"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Concepts",
          "type": "array"
        }
      },
      "required": [
        "title",
        "concepts"
      ],
      "title": "ConceptCardsBlock",
      "type": "object"
    },
    "ConceptMapBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "concept_map",
          "default": "concept_map",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "central_node_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Central Node Id",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/MapNodeView"
          },
          "maxItems": 40,
          "minItems": 2,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/MapEdgeView"
          },
          "maxItems": 80,
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "title",
        "central_node_id",
        "nodes"
      ],
      "title": "ConceptMapBlock",
      "type": "object"
    },
    "ConceptView": {
      "additionalProperties": false,
      "properties": {
        "term": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Term",
          "type": "string"
        },
        "definition": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "example": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Example"
        }
      },
      "required": [
        "term",
        "definition"
      ],
      "title": "ConceptView",
      "type": "object"
    },
    "Difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "FallbackBlock": {
      "additionalProperties": false,
