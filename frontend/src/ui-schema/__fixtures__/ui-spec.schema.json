          "maxItems": 5,
          "minItems": 2,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/ComparisonRowView"
          },
          "maxItems": 15,
          "minItems": 1,
          "title": "Rows",
