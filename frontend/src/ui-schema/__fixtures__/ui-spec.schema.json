{
  "$defs": {
    "ActivityType": {
      "enum": [
        "quiz",
        "exercise",
        "flashcards",
        "explanation",
        "revision",
        "mini_game"
      ],
      "title": "ActivityType",
      "type": "string"
    },
    "Bar": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "Bar",
      "type": "object"
    },
    "BarChartBlock": {
      "additionalProperties": false,
      "description": "Rendered with a mandatory table alternative for screen readers.",
      "properties": {
        "type": {
          "const": "bar_chart",
          "default": "bar_chart",
          "title": "Type",
          "type": "string"
        },
        "title_code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Title Code",
          "type": "string"
        },
        "value_unit": {
          "enum": [
            "ratio",
            "count"
          ],
          "title": "Value Unit",
          "type": "string"
        },
        "bars": {
          "items": {
            "$ref": "#/$defs/Bar"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Bars",
          "type": "array"
        }
      },
      "required": [
        "title_code",
        "value_unit",
        "bars"
      ],
      "title": "BarChartBlock",
      "type": "object"
    },
    "BulletListBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "bullet_list",
          "default": "bullet_list",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "BulletListBlock",
      "type": "object"
    },
    "CalloutBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "callout",
          "default": "callout",
          "title": "Type",
          "type": "string"
        },
        "tone": {
          "default": "info",
          "enum": [
            "info",
            "success",
            "warning",
            "error"
          ],
          "title": "Tone",
          "type": "string"
        },
        "message_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Code"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "title": "CalloutBlock",
      "type": "object"
    },
    "ComparisonRowView": {
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Criterion",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "criterion",
        "values"
      ],
      "title": "ComparisonRowView",
      "type": "object"
    },
    "ComparisonTableBlock": {
      "additionalProperties": false,
