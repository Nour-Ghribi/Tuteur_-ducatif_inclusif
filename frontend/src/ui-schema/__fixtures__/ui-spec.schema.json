        }
      },
      "required": [
        "title",
        "columns",
        "rows"
      ],
      "title": "ComparisonTableBlock",
      "type": "object"
    },
    "ConceptCardsBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "concept_cards",
          "default": "concept_cards",
          "title": "Type",
