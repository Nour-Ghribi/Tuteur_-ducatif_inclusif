        "type": {
          "const": "fallback",
          "default": "fallback",
          "title": "Type",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Reason Code",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
