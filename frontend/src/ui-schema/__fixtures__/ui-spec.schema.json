        "text_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Code"
        },
        "level": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        }
      },
      "title": "HeadingBlock",
      "type": "object"
    },
    "ImageBlock": {
      "additionalProperties": false,
      "description": "Course figure. ``alt_text`` is mandatory; ``adapted`` marks a colour-vision variant.",
