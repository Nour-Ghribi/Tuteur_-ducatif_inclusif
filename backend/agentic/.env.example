# Copier en .env (jamais commité). Toutes les variables ont le préfixe TUTOR_.

# development | test | staging | production
TUTOR_ENVIRONMENT=development

# --- Origine des services ---------------------------------------------------------------------
# mock   : services simulés (démo, tests) — refusé en production
# tuteur : module GenAI + RAG de ce dépôt appelé directement (pip install -e . à la racine)
# http   : services des coéquipiers, joints par URL (voir ci-dessous)
TUTOR_GENAI_BACKEND=mock
TUTOR_ALLOW_MOCKS=true

# URLs des services en mode http (vide = service simulé si TUTOR_ALLOW_MOCKS=true)
TUTOR_RAG_SERVICE_URL=
TUTOR_GENAI_SERVICE_URL=
TUTOR_RL_SERVICE_URL=
TUTOR_LEARNING_RECORDS_SERVICE_URL=
TUTOR_INCLUSION_SERVICE_URL=
# Jeton envoyé aux services des coéquipiers (à fournir par le gestionnaire de secrets / la CI)
TUTOR_SERVICE_API_KEY=

# --- Mode tuteur : figures du cours et inclusion ------------------------------------------------
TUTOR_IMAGES_DIR=data/images
TUTOR_ADAPTED_IMAGES_DIR=data/images_adapted
# Description des figures : modèle de vision compatible OpenAI (ex. llava sur Ollama). Vide = pas de
# description automatique (la figure est affichée avec un texte de remplacement explicite).
TUTOR_VISION_MODEL=
TUTOR_VISION_BASE_URL=
TUTOR_VISION_API_KEY=

# --- Résilience ---------------------------------------------------------------------------------
TUTOR_ADAPTER_TIMEOUT_S=8        # services HTTP
TUTOR_GENAI_TIMEOUT_S=60         # appels LLM (module en processus)
TUTOR_ADAPTER_MAX_RETRIES=2
TUTOR_ADAPTER_BACKOFF_S=0.25
TUTOR_GRAPH_TIMEOUT_S=90
TUTOR_MAX_GENERATION_ATTEMPTS=2

# Classifieur LLM pour les demandes ambiguës (le routage par règles reste prioritaire)
TUTOR_INTENT_CLASSIFIER_ENABLED=false

# --- Authentification de DÉVELOPPEMENT uniquement ------------------------------------------------
# Ce n'est PAS une authentification réelle ; refusée hors development/test.
# Laisser vide : le serveur de développement génère deux jetons jetables et les affiche au démarrage.
# TUTOR_DEV_AUTH_TOKENS={"<jeton-aléatoire-24+car>":{"subject_ref":"student-dev-1","role":"student"}}
TUTOR_DEV_AUTH_TOKENS={}
